# .env file - Create this file in your project root
# Add your actual values here (don't commit this file to version control!)

# API Keys
OPENAI_API_KEY=


# Email Settings
EMAIL_USER=
EMAIL_APP_PASSWORD=
NOTIFICATION_EMAIL=

# Instructions for Gmail App Password:
# 1. Go to Google Account settings
# 2. Security > 2-Step Verification (must be enabled)
# 3. App passwords > Generate new app password
# 4. Use the generated password (not your regular Gmail password)